DEVICE=mps
HF_HOME=./modelsweights
HF_HUB_DISABLE_XET=1
FISH_TTS_DTYPE=float16
FISH_TTS_STORAGE_ROOT=storage/fish_speech_service
FISH_TTS_COMPILE=false
# Backend used when compilation is enabled: auto, aot_eager, or inductor.
# auto preserves CUDA=inductor and MPS/CPU=aot_eager; benchmark before changing.
# For S2-Pro on MPS, use inductor for the measured speedup documented in README.
FISH_TTS_COMPILE_BACKEND=auto
FISH_TTS_MAX_SEQ_LEN=4096
PYTORCH_ENABLE_MPS_FALLBACK=1
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.55
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.75

# Optional overrides:
# FISH_SPEECH_MODEL_ID=fishaudio/s2-pro
# FISH_SPEECH_MODELSCOPE_MODEL_ID=fishaudio/s2-pro
# FISH_SPEECH_MODEL_DIR=modelsweights/s2-pro
# FISH_SPEECH_DECODER_CHECKPOINT_PATH=modelsweights/s2-pro/codec.pth
# FISH_TTS_DECODER_CONFIG_NAME=modded_dac_vq
# FISH_TTS_MODEL_ID=s2-pro
# FISH_TTS_VOICES_DIR=storage/fish_speech_service/voices
# Optional authentication for /v1/* only (Bearer or api-key header):
# FISH_TTS_API_KEY=your-local-service-key
