DEVICE=mps
HF_HOME=./modelsweights
HF_HUB_DISABLE_XET=1
FISH_TTS_DTYPE=float16
FISH_TTS_STORAGE_ROOT=storage/fish_speech_service
FISH_TTS_COMPILE=false
FISH_TTS_MAX_SEQ_LEN=4096
PYTORCH_ENABLE_MPS_FALLBACK=1
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.55
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.75

# Optional overrides:
# FISH_SPEECH_MODEL_ID=fishaudio/s2-pro
# FISH_SPEECH_MODELSCOPE_MODEL_ID=fishaudio/s2-pro
# FISH_SPEECH_MODEL_DIR=modelsweights/s2-pro
# FISH_SPEECH_DECODER_CHECKPOINT_PATH=modelsweights/s2-pro/codec.pth
# FISH_TTS_DECODER_CONFIG_NAME=modded_dac_vq
